[Unit]
Description=Capstone BTC USD segmented collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
Type=simple
User=capstone
WorkingDirectory=/opt/capstone-btc
ExecStart=/opt/capstone-btc/.venv/bin/python -B -u /opt/capstone-btc/ops/cloud_service.py --project /opt/capstone-btc --data /opt/capstone-btc/data/cloud-study-20261002 --segment-seconds 3600 --require-backup --end 2026-11-01T00:00:00+00:00
Restart=on-failure
RestartSec=15
KillMode=mixed
TimeoutStopSec=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/capstone-btc/data
MemoryMax=256M
CPUQuota=50%
UMask=0077
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
[Install]
WantedBy=multi-user.target
